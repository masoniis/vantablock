// The phase 1 showcase: a meadow grove with crystal outcrops and kinetic sculptures, built to
// stress close-up detail and hundreds of overlapping, rotated, animated instances.
(
    grids: [
        // 12 x 12 tiles of 10.24 m meadow
        (asset: "meadow_tile", center: (0.0, 0.0, 0.0), tiles_per_side: 12, spacing: 10.24, seed: 4),
    ],
    objects: [
        (asset: "kinetic_rotor", position: (0.0, 0.0, 6.0), yaw_degrees: 20.0),
        (asset: "kinetic_rotor", position: (-4.5, 0.0, 3.0), yaw_degrees: -35.0, scale: 0.7),
        (asset: "oak", position: (3.5, 0.0, -2.0), yaw_degrees: 40.0, scale: 1.1),
    ],
    scatters: [
        (asset: "oak", count: 36, center: (0.0, 0.0, -24.0), radius: 30.0, min_spacing: 5.0, scale: (0.75, 1.25), gust: (0.4, 1.0), seed: 1),
        // overlapping, tilted clusters: the instancing stress case
        (asset: "crystal_cluster", count: 160, center: (14.0, 0.0, 4.0), radius: 9.0, scale: (0.4, 1.4), tilt_degrees: 35.0, seed: 2),
